# Recall API key (kosongkan untuk mode paper/dry-run)
RECALL_API_KEY=
# sandbox: https://api.sandbox.competitions.recall.network
# production: https://api.competitions.recall.network
RECALL_API_URL=https://api.sandbox.competitions.recall.network
# true = tidak mengirim order sungguhan
DRY_RUN=true

# Meme screener: chain yang di-scan dan scan otomatis tiap N menit (0 = manual dari dashboard)
MEME_CHAINS=solana,bsc,base,ethereum
MEME_AUTO_MINUTES=0
# Dashboard: 0.0.0.0 untuk akses dari jaringan lain (tidak ada login, lindungi dengan firewall/VPN)
UI_HOST=127.0.0.1
UI_PORT=8787
